{
  "expo": {
    "name": "Hyderabad Rishta",
    "slug": "hyderabad-rishta",
    "owner": "mukarramjah",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hyderabadrishta.app",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#4A0E1F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.hyderabadrishta.app",
      "allowBackup": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "hyderabadrishta.com",
              "pathPrefix": "/r/"
            },
            {
              "scheme": "https",
              "host": "www.hyderabadrishta.com",
              "pathPrefix": "/r/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro",
      "name": "Hyderabad Rishta",
      "themeColor": "#4A0E1F",
      "backgroundColor": "#FAF6F1"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-font",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF6F1",
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Hyderabad Rishta to access your photos so you can add them to your biodata.",
          "cameraPermission": "Allow Hyderabad Rishta to use the camera so you can take a photo for your biodata.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#4A0E1F",
          "defaultChannel": "default"
        }
      ]
    ],
    "scheme": "hyderabadrishta",
    "backgroundColor": "#FAF6F1",
    "extra": {
      "supportsRTL": true,
      "eas": {
        "projectId": "4521260e-821b-4eea-95ab-049c2588f224"
      }
    }
  }
}
