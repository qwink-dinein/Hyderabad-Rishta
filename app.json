{
  "expo": {
    "name": "Hyderabad Rishta",
    "slug": "hyderabad-rishta",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hyderabadrishta.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#123D32",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.hyderabadrishta.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro",
      "name": "Hyderabad Rishta",
      "themeColor": "#123D32",
      "backgroundColor": "#F8F4EB"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-font",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8F4EB"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Hyderabad Rishta to access your photos so you can add them to your biodata."
        }
      ]
    ],
    "scheme": "hyderabadrishta",
    "backgroundColor": "#F8F4EB",
    "extra": {
      "supportsRTL": true
    }
  }
}
